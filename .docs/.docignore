# ═══════════════════════════════════════════════
# .docignore — blacklist for docs generation
# Syntax: *.ext, dirname/, filename. Comments: #
# ═══════════════════════════════════════════════

# Images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.ico
*.webp
*.tiff
*.tif
*.svg
*.avif
*.heic
*.heif
*.raw
*.cr2
*.nef

# Documents
*.doc
*.docx
*.pdf
*.xls
*.xlsx
*.ppt
*.pptx
*.odt
*.ods
*.odp
*.rtf
*.epub

# Audio
*.mp3
*.wav
*.ogg
*.flac
*.aac
*.wma
*.m4a

# Video
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm
*.m4v
*.mpeg
*.mpg

# Fonts
*.ttf
*.otf
*.woff
*.woff2
*.eot

# Archives
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.tgz

# Binaries & executables
*.exe
*.dll
*.so
*.dylib
*.bin
*.msi
*.dmg
*.deb
*.rpm
*.app

# Compiled / object files
*.o
*.obj
*.pyc
*.pyo
*.class
*.jar
*.war

# Design files
*.psd
*.ai
*.sketch
*.fig
*.xd

# Database
*.sqlite
*.db
*.mdb

# Source maps & minified
*.map
*.min.js
*.min.css

# Lock files
package-lock.json
yarn.lock
composer.lock
Gemfile.lock
poetry.lock
pnpm-lock.yaml

# Directories
node_modules/
vendor/
dist/
build/
.git/
.github/
.docs/
__pycache__/
.cache/
.tmp/
.vscode/
.idea/
bower_components/
